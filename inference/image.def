Bootstrap: docker
From: python:3.12-slim

%labels
    Author "Simon Hackl"
    Version 1.0.0
    Description "PhageGAP classifier/inference service apptainer image."

%files
    src/phagegapinference/__init__.py /app/phagegapinference/__init__.py
    src/phagegapinference/api.py /app/phagegapinference/api.py
    src/phagegapinference/embed.py /app/phagegapinference/embed.py
    src/phagegapinference/model.py /app/phagegapinference/model.py
    src/phagegapinference/pool.py /app/phagegapinference/pool.py
    src/phagegapinference/predict.py /app/phagegapinference/predict.py
    src/phagegapinference/utils.py /app/phagegapinference/utils.py
    requirements.txt /app/requirements.txt

%post
    cd /app

    apt-get update
    apt-get install -y --no-install-recommends findutils
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir setuptools wheel
    python -m pip install --no-cache-dir -r requirements.txt

    # Delete Python cache.
    find /usr/local/lib/python3.12/site-packages \
        -type d -name "__pycache__" -prune -exec rm -rf {} +
    find /usr/local/lib/python3.12/site-packages \
        -type f -name "*.pyc" -delete

%environment
    export PHAGEGAP_BIND_ADDRESS=0.0.0.0
    export PHAGEGAP_PORT=20101
    export PYTHONUNBUFFERED=1
    export CUDA_LOG_FILE=stderr

%startscript
    cd /app

    exec gunicorn \
        --bind "${PHAGEGAP_BIND_ADDRESS}:${PHAGEGAP_PORT}" \
        --workers 1 \
        --threads 1 \
        --timeout 600 \
        --access-logfile - \
        --error-logfile - \
        "phagegapinference:app"
